# ──────────────────────────────────────────────────────────────────────────
# OneClick CV — environment variables
# Copy this file to .env.local and fill in the values you need.
# The app works fully with NONE of these set (fallback engine + no job-link
# fetching disabled state) — see README "Running without any keys".
# ──────────────────────────────────────────────────────────────────────────

# ---- AI provider (optional) --------------------------------------------
# Leave both unset to run entirely on the built-in profession-based fallback
# engine (lib/ai/fallbackEngine.ts). Set ONE of the following to activate a
# real AI provider for suggestions and cover-letter drafting.
# See lib/ai/providerInterface.ts — adding a new provider only requires
# implementing the AIProvider interface and registering it in
# lib/ai/provider.server.ts.

AI_PROVIDER=fallback
# AI_PROVIDER=anthropic
# AI_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- AI request limits ---------------------------------------------------
AI_MAX_INPUT_CHARS=6000
AI_REQUEST_TIMEOUT_MS=20000
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Job-link analyser (server-side URL fetch) ---------------------------
JOB_FETCH_TIMEOUT_MS=8000
JOB_FETCH_MAX_BYTES=2000000
JOB_FETCH_MAX_REDIRECTS=3
JOB_FETCH_RATE_LIMIT_PER_MINUTE=10

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OneClick CV
