{
  "name": "oneclick-cv",
  "version": "0.1.0",
  "private": true,
  "description": "OneClick CV — Professional CVs. Smarter applications. A premium CV & cover-letter builder for UAE job seekers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4",
    "zod": "^3.23.8",
    "clsx": "^2.1.1",
    "react-easy-crop": "^5.0.8",
    "@react-pdf/renderer": "^3.4.4",
    "docx": "^8.5.0",
    "cheerio": "^1.0.0-rc.12",
    "file-saver": "^2.0.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/file-saver": "^2.0.7",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "vitest": "^1.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@playwright/test": "^1.45.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
